# -*- coding: utf-8 -*-
import os
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import Dataset, DataLoader
from PIL import Image
from transformers import CLIPProcessor, CLIPModel
from torchvision import transforms
import logging
from tqdm import tqdm
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class UAFDataset(Dataset):
    def __init__(self, img_root, meta_root, genchange_root, is_train, preprocess, clip_processor):
        self.img_root = img_root
        self.meta_root = meta_root
        self.genchange_root = genchange_root
        self.is_train = is_train
        self.preprocess = preprocess
        self.clip_processor = clip_processor
        self.clip_max_len = 77

        split_file = os.path.join(meta_root, 'train.txt' if is_train else 'val.txt')
        if not os.path.exists(split_file):
            raise FileNotFoundError("Split file not found: {}".format(split_file))

        self.img_paths = []
        self.code_paths = []
        self.labels = []

        with open(split_file, 'r') as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                img_name = line.split(',')[0].strip()

                if "-0-" in img_name:
                    label = 0
                elif "-1-" in img_name:
                    label = 1
                else:
                    logger.warning("skip unknown filename: {}".format(img_name))
                    continue

                img_path = os.path.join(img_root, 'uaf', img_name)
                code_name = img_name.replace("gen", "").replace('.jpg', '.c')
                code_path = os.path.join(genchange_root, code_name)

                if os.path.exists(img_path) and os.path.exists(code_path):
                    self.img_paths.append(img_path)
                    self.code_paths.append(code_path)
                    self.labels.append(label)

        if len(self.img_paths) == 0:
            raise ValueError("No valid samples found. Check your dataset paths.")
        cnt_uaf = sum(1 for l in self.labels if l==0)
        cnt_non = len(self.labels) - cnt_uaf
        logger.info("Dataset loaded: {} samples | UAF(label0)={}, NonUAF(label1)={}".format(len(self), cnt_uaf, cnt_non))

    def __len__(self):
        return len(self.img_paths)

    def __getitem__(self, idx):
        img = Image.open(self.img_paths[idx]).convert('RGB')
        img_tensor = self.preprocess(img)

        with open(self.code_paths[idx], 'r', encoding='utf-8', errors="ignore") as f:
            code_text = f.read()

        tokenized = self.clip_processor(
            text=code_text,
            max_length=self.clip_max_len,
            truncation=True,
            padding='max_length',
            return_tensors='pt'
        )
        input_ids = tokenized['input_ids'].squeeze(0)
        attention_mask = tokenized['attention_mask'].squeeze(0)
        label = self.labels[idx]
        return img_tensor, input_ids, attention_mask, label

class SimpleVLM(nn.Module):
    """
    Binary UAF classifier.
    Model inputs: image and source-code tokens only.
    Ground-truth labels are used exclusively by the loss/metrics, never as model inputs.
    """
    def __init__(self, clip_model):
        super().__init__()
        self.clip_model = clip_model

        # Freeze the pretrained CLIP encoders; train the classification head.
        for param in self.clip_model.parameters():
            param.requires_grad = False

        with torch.no_grad():
            device = next(self.clip_model.parameters()).device
            dummy_pixel = torch.randn(1, 3, 224, 224, device=device)
            dummy_ids = torch.zeros(1, 77, dtype=torch.long, device=device)
            dummy_mask = torch.ones(1, 77, dtype=torch.long, device=device)
            out = self.clip_model(
                pixel_values=dummy_pixel,
                input_ids=dummy_ids,
                attention_mask=dummy_mask
            )
            emb_dim = out.image_embeds.shape[-1]

        self.emb_dim = emb_dim
        logger.info("Detected CLIP embedding dim = {}".format(emb_dim))

        # Only image and code embeddings are concatenated: 2 * emb_dim.
        self.classifier = nn.Sequential(
            nn.Linear(emb_dim * 2, 512),
            nn.ReLU(),
            nn.Dropout(0.2),
            nn.Linear(512, 2)
        )

    def forward(self, pixel_values, input_ids, attention_mask):
        """
        Inputs:
            pixel_values: image tensor [batch, 3, 224, 224]
            input_ids: source-code token IDs [batch, 77]
            attention_mask: source-code attention mask [batch, 77]
        Returns:
            logits [batch, 2] for [UAF, non-UAF].
        """
        out = self.clip_model(
            pixel_values=pixel_values,
            input_ids=input_ids,
            attention_mask=attention_mask
        )
        img_feat = out.image_embeds
        txt_feat = out.text_embeds

        fused = torch.cat([img_feat, txt_feat], dim=1)
        logits = self.classifier(fused)
        return logits


def evaluate(model, dataloader, criterion, device):
    model.eval()
    total_loss = 0
    all_labels = []
    all_preds = []
    with torch.no_grad():
        for images, input_ids, masks, labels in tqdm(dataloader, desc="Val"):
            images = images.to(device)
            input_ids = input_ids.to(device)
            masks = masks.to(device)
            labels = labels.to(device)
            logits = model(images, input_ids, masks)
            loss = criterion(logits, labels)
            total_loss += loss.item()
            preds = torch.argmax(logits, dim=1)
            all_labels.extend(labels.cpu().numpy())
            all_preds.extend(preds.cpu().numpy())
    avg_loss = total_loss / len(dataloader)
    acc = accuracy_score(all_labels, all_preds)
    prec = precision_score(all_labels, all_preds, average="weighted")
    rec = recall_score(all_labels, all_preds, average="weighted")
    f1 = f1_score(all_labels, all_preds, average="weighted")
    return avg_loss, acc, prec, rec, f1

def train_model(model, train_loader, val_loader, optimizer, criterion, device, epochs=10, save_dir='./simple_vlm', patience=3):
    os.makedirs(save_dir, exist_ok=True)
    best_f1 = -1.0
    patience_counter = 0
    for epoch in range(epochs):
        model.train()
        total_loss = 0.0
        correct = 0
        total = 0
        pbar = tqdm(train_loader, desc="Train Epoch {}/{}".format(epoch+1, epochs))
        for images, input_ids, masks, labels in pbar:
            images = images.to(device)
            input_ids = input_ids.to(device)
            masks = masks.to(device)
            labels = labels.to(device)

            optimizer.zero_grad()
            logits = model(images, input_ids, masks)
            loss = criterion(logits, labels)
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
            optimizer.step()

            total_loss += loss.item()
            preds = torch.argmax(logits, dim=1)
            correct += (preds == labels).sum().item()
            total += labels.size(0)
            pbar.set_postfix({"loss": "{:.4f}".format(loss.item()), "acc": "{:.4f}".format(correct/total)})

        train_loss = total_loss / len(train_loader)
        train_acc = correct / total
        logger.info("Epoch {} | Train Loss: {:.4f} | Train Acc: {:.4f}".format(epoch+1, train_loss, train_acc))

        val_loss, val_acc, val_prec, val_rec, val_f1 = evaluate(model, val_loader, criterion, device)
        logger.info("Epoch {} | Val Loss:{:.4f} | Acc:{:.4f} | Prec:{:.4f} | Recall:{:.4f} | F1:{:.4f}".format(epoch+1, val_loss, val_acc, val_prec, val_rec, val_f1))

        if val_f1 > best_f1:
            best_f1 = val_f1
            patience_counter = 0
            ckpt_path = os.path.join(save_dir, "best_simple_model.pth")
            torch.save({"model_state": model.state_dict(), "epoch":epoch, "best_f1":best_f1}, ckpt_path)
            logger.info("Save best model, F1={:.4f} -> {}".format(best_f1, ckpt_path))
        else:
            patience_counter +=1
            logger.info("F1 no improve, patience {}/{}".format(patience_counter, patience))
            if patience_counter >= patience:
                logger.info("Early stop triggered")
                break
    logger.info("Training finished. Best val F1 = {:.4f}".format(best_f1))

