# ============================================================
# Shared multi-head attention utilities
# ============================================================
class MultiHeadAttentionBase(nn.Module):
    def __init__(self, hidden_size=HIDDEN_SIZE,
                 num_heads=NUM_ATTENTION_HEADS,
                 dropout=ATTENTION_DROPOUT):
        super().__init__()
        if hidden_size % num_heads != 0:
            raise ValueError("hidden_size must be divisible by num_heads")

        self.hidden_size = hidden_size
        self.num_heads = num_heads
        self.head_dim = hidden_size // num_heads

        self.query = nn.Linear(hidden_size, hidden_size)
        self.key = nn.Linear(hidden_size, hidden_size)
        self.value = nn.Linear(hidden_size, hidden_size)
        self.out_proj = nn.Linear(hidden_size, hidden_size)
        self.dropout = nn.Dropout(dropout)

    def split_heads(self, x):
        batch, length, _ = x.shape
        return x.view(
            batch, length, self.num_heads, self.head_dim
        ).transpose(1, 2)

    def merge_heads(self, x):
        batch, heads, length, head_dim = x.shape
        return x.transpose(1, 2).contiguous().view(
            batch, length, heads * head_dim
        )

    def project_qkv(self, hidden_states):
        return (
            self.split_heads(self.query(hidden_states)),
            self.split_heads(self.key(hidden_states)),
            self.split_heads(self.value(hidden_states))
        )


# ============================================================
# Local sliding-window attention for the six lower layers
# ============================================================
class LocalWindowAttention(MultiHeadAttentionBase):
    def __init__(self, window_size=LOCAL_WINDOW_SIZE, **kwargs):
        super().__init__(**kwargs)
        self.window_size = window_size

    def forward(self, hidden_states, attention_mask):
        batch, length, _ = hidden_states.shape
        q, k, v = self.project_qkv(hidden_states)

        scores = torch.matmul(q, k.transpose(-1, -2))
        scores = scores / (self.head_dim ** 0.5)

        positions = torch.arange(length, device=hidden_states.device)
        distance = (positions[:, None] - positions[None, :]).abs()
        local_mask = distance < self.window_size

        valid_keys = attention_mask[:, None, None, :].bool()
        allowed = local_mask[None, None, :, :] & valid_keys

        scores = scores.masked_fill(~allowed, torch.finfo(scores.dtype).min)
        weights = F.softmax(scores, dim=-1)
        weights = self.dropout(weights)

        context = torch.matmul(weights, v)
        context = self.merge_heads(context)
        return self.out_proj(context)


# ============================================================
# MoBA dynamic top-k block attention for the four upper layers
# ============================================================
class MoBABlockAttention(MultiHeadAttentionBase):
    """
    Block routing:
      1. Divide tokens into blocks of 64.
      2. Mean-pool Q and K within each block for routing scores.
      3. Each query block selects its top-2 key blocks per head.
      4. Token-level attention is computed only over selected blocks.

    The implementation uses a dense attention tensor with a block-sparse
    mask for clarity and compatibility. The routing pattern is top-k sparse.
    """

    def __init__(self, block_size=MOBA_BLOCK_SIZE,
                 top_k=MOBA_TOP_K, **kwargs):
        super().__init__(**kwargs)
        self.block_size = block_size
        self.top_k = top_k

    def forward(self, hidden_states, attention_mask):
        batch, length, _ = hidden_states.shape

        if length % self.block_size != 0:
            raise ValueError(
                f"Sequence length {length} must be divisible by "
                f"MoBA block size {self.block_size}. Use fixed-length "
                "tokenization with max_length=512."
            )

        q, k, v = self.project_qkv(hidden_states)
        num_blocks = length // self.block_size

        q_blocks = q.reshape(
            batch, self.num_heads, num_blocks, self.block_size, self.head_dim
        )
        k_blocks = k.reshape(
            batch, self.num_heads, num_blocks, self.block_size, self.head_dim
        )

        # Block-level routing representations.
        q_route = q_blocks.mean(dim=3)
        k_route = k_blocks.mean(dim=3)

        route_scores = torch.matmul(
            q_route, k_route.transpose(-1, -2)
        ) / (self.head_dim ** 0.5)

        # Exclude blocks that contain only padding tokens from routing.
        valid_key_blocks = attention_mask.reshape(
            batch, num_blocks, self.block_size
        ).bool().any(dim=-1)
        route_scores = route_scores.masked_fill(
            ~valid_key_blocks[:, None, None, :],
            torch.finfo(route_scores.dtype).min
        )

        # Select the top-k key blocks for each query block and attention head.
        k_select = min(self.top_k, num_blocks)
        selected = route_scores.topk(k_select, dim=-1).indices

        block_route_mask = torch.zeros_like(route_scores, dtype=torch.bool)
        block_route_mask.scatter_(-1, selected, True)

        # Expand block-level routing mask to token-level attention mask.
        token_route_mask = block_route_mask.repeat_interleave(
            self.block_size, dim=2
        ).repeat_interleave(self.block_size, dim=3)

        valid_keys = attention_mask[:, None, None, :].bool()
        allowed = token_route_mask & valid_keys

        scores = torch.matmul(q, k.transpose(-1, -2))
        scores = scores / (self.head_dim ** 0.5)
        scores = scores.masked_fill(
            ~allowed, torch.finfo(scores.dtype).min
        )

        weights = F.softmax(scores, dim=-1)
        weights = self.dropout(weights)

        context = torch.matmul(weights, v)
        context = self.merge_heads(context)
        return self.out_proj(context)


# ============================================================
# Transformer layer initialized from a pretrained Longformer layer
# ============================================================
class MLGTransformerLayer(nn.Module):
    def __init__(self, attention_type, intermediate_size,
                 hidden_size=HIDDEN_SIZE, dropout=0.1):
        super().__init__()

        if attention_type == "local":
            self.attention = LocalWindowAttention()
        elif attention_type == "moba":
            self.attention = MoBABlockAttention()
        else:
            raise ValueError(f"Unknown attention type: {attention_type}")

        self.attention_output_dropout = nn.Dropout(dropout)
        self.attention_layer_norm = nn.LayerNorm(hidden_size)

        self.intermediate = nn.Linear(hidden_size, intermediate_size)
        self.output = nn.Linear(intermediate_size, hidden_size)
        self.output_dropout = nn.Dropout(dropout)
        self.output_layer_norm = nn.LayerNorm(hidden_size)

    def forward(self, hidden_states, attention_mask):
        attention_output = self.attention(hidden_states, attention_mask)
        hidden_states = self.attention_layer_norm(
            hidden_states + self.attention_output_dropout(attention_output)
        )

        intermediate = F.gelu(self.intermediate(hidden_states))
        layer_output = self.output(intermediate)
        hidden_states = self.output_layer_norm(
            hidden_states + self.output_dropout(layer_output)
        )
        return hidden_states


def copy_longformer_layer_weights(target_layer, source_layer):
    """Initialize custom attention and FFN from one pretrained Longformer layer."""
    source_attn = source_layer.attention.self
    target_attn = target_layer.attention

    # Initialize Q/K/V from pretrained Longformer local-attention projections.
    target_attn.query.load_state_dict(source_attn.query.state_dict())
    target_attn.key.load_state_dict(source_attn.key.state_dict())
    target_attn.value.load_state_dict(source_attn.value.state_dict())

    # Longformer attention output projection and normalization.
    source_attn_output = source_layer.attention.output
    target_attn.out_proj.load_state_dict(source_attn_output.dense.state_dict())
    target_layer.attention_layer_norm.load_state_dict(
        source_attn_output.LayerNorm.state_dict()
    )

    # Feed-forward network and output normalization.
    target_layer.intermediate.load_state_dict(
        source_layer.intermediate.dense.state_dict()
    )
    target_layer.output.load_state_dict(
        source_layer.output.dense.state_dict()
    )
    target_layer.output_layer_norm.load_state_dict(
        source_layer.output.LayerNorm.state_dict()
    )


# ============================================================
# Exactly six local Longformer layers + four MoBA layers
# ============================================================
class SixLongformerFourMoBA(nn.Module):
    def __init__(self, pretrained_name=LONGFORMER_NAME):
        super().__init__()

        pretrained = LongformerModel.from_pretrained(pretrained_name)
        config = pretrained.config

        if config.hidden_size != HIDDEN_SIZE:
            raise ValueError(
                f"Expected hidden size {HIDDEN_SIZE}, got {config.hidden_size}"
            )
        if config.num_attention_heads != NUM_ATTENTION_HEADS:
            raise ValueError(
                f"Expected {NUM_ATTENTION_HEADS} heads, "
                f"got {config.num_attention_heads}"
            )
        if config.num_hidden_layers < 10:
            raise ValueError("Pretrained Longformer checkpoint must have >=10 layers")

        self.embeddings = pretrained.embeddings
        self.hidden_size = config.hidden_size

        intermediate_size = config.intermediate_size
        source_layers = pretrained.encoder.layer

        self.longformer_layers = nn.ModuleList([
            MLGTransformerLayer(
                "local", intermediate_size,
                hidden_size=config.hidden_size,
                dropout=config.hidden_dropout_prob
            )
            for _ in range(NUM_LONGFORMER_LAYERS)
        ])

        self.moba_layers = nn.ModuleList([
            MLGTransformerLayer(
                "moba", intermediate_size,
                hidden_size=config.hidden_size,
                dropout=config.hidden_dropout_prob
            )
            for _ in range(NUM_MOBA_LAYERS)
        ])

        # Copy pretrained layers 0-5 into local-window Longformer layers.
        for i in range(NUM_LONGFORMER_LAYERS):
            copy_longformer_layer_weights(
                self.longformer_layers[i], source_layers[i]
            )

        # Copy pretrained layers 6-9 into the four MoBA layers.
        for i in range(NUM_MOBA_LAYERS):
            copy_longformer_layer_weights(
                self.moba_layers[i], source_layers[NUM_LONGFORMER_LAYERS + i]
            )

        self.config = config
        del pretrained

        logger.info(
            "Initialized 6 local Longformer layers from pretrained layers 0-5 "
            "and 4 MoBA layers from pretrained layers 6-9."
        )

    def forward(self, input_ids, attention_mask):
        hidden_states = self.embeddings(input_ids=input_ids)

        for layer in self.longformer_layers:
            hidden_states = layer(hidden_states, attention_mask)

        for layer in self.moba_layers:
            hidden_states = layer(hidden_states, attention_mask)

        return hidden_states


# ============================================================
# Full two-input multimodal MLG-UAF model
# ============================================================
class MLGUAF6L4M(nn.Module):
    def __init__(self, pretrained_longformer=LONGFORMER_NAME,
                 pretrained_vit=True):
        super().__init__()

        vit_weights = ViT_B_16_Weights.DEFAULT if pretrained_vit else None
        self.vit = vit_b_16(weights=vit_weights)
        vit_dim = self.vit.heads.head.in_features
        self.vit.heads = nn.Identity()

        self.code_encoder = SixLongformerFourMoBA(pretrained_longformer)

        self.image_projection = nn.Sequential(
            nn.Linear(vit_dim, PROJECTION_DIM),
            nn.LayerNorm(PROJECTION_DIM),
            nn.GELU(),
            nn.Dropout(MLP_DROPOUT)
        )

        self.code_projection = nn.Sequential(
            nn.Linear(self.code_encoder.hidden_size, PROJECTION_DIM),
            nn.LayerNorm(PROJECTION_DIM),
            nn.GELU(),
            nn.Dropout(MLP_DROPOUT)
        )

        self.fusion_mlp = nn.Sequential(
            nn.Linear(PROJECTION_DIM * 2, 512),
            nn.LayerNorm(512),
            nn.GELU(),
            nn.Dropout(MLP_DROPOUT),
            nn.Linear(512, 256),
            nn.LayerNorm(256),
            nn.GELU(),
            nn.Dropout(MLP_DROPOUT),
            nn.Linear(256, NUM_CLASSES)
        )

    def forward(self, images, input_ids, attention_mask):
        image_features = self.image_projection(self.vit(images))

        token_states = self.code_encoder(input_ids, attention_mask)
        mask = attention_mask.unsqueeze(-1).to(token_states.dtype)
        code_pooled = (token_states * mask).sum(dim=1)
        code_pooled = code_pooled / mask.sum(dim=1).clamp(min=1.0)
        code_features = self.code_projection(code_pooled)

        fused = torch.cat([image_features, code_features], dim=1)
        return self.fusion_mlp(fused)


# ============================================================
# Training / evaluation
# ============================================================
def run_epoch(model, loader, criterion, optimizer=None, desc=""):
    training = optimizer is not None
    model.train(training)

    total_loss = 0.0
    y_true, y_pred = [], []

    with torch.set_grad_enabled(training):
        for batch in tqdm(loader, desc=desc, leave=False):
            images = batch["image"].to(DEVICE)
            input_ids = batch["input_ids"].to(DEVICE)
            attention_mask = batch["attention_mask"].to(DEVICE)
            labels = batch["label"].to(DEVICE)

            if training:
                optimizer.zero_grad(set_to_none=True)

            logits = model(images, input_ids, attention_mask)
            loss = criterion(logits, labels)

            if training:
                loss.backward()
                torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
                optimizer.step()

            total_loss += loss.item()
            y_pred.extend(logits.argmax(dim=1).detach().cpu().tolist())
            y_true.extend(labels.detach().cpu().tolist())

    return {
        "loss": total_loss / max(1, len(loader)),
        "accuracy": accuracy_score(y_true, y_pred),
        "precision": precision_score(
            y_true, y_pred, average="weighted", zero_division=0
        ),
        "recall": recall_score(
            y_true, y_pred, average="weighted", zero_division=0
        ),
        "f1": f1_score(
            y_true, y_pred, average="weighted", zero_division=0
        )
    }


@torch.no_grad()
def save_predictions(model, loader):
    model.eval()
    rows = []

    for batch in tqdm(loader, desc="Predict", leave=False):
        images = batch["image"].to(DEVICE)
        input_ids = batch["input_ids"].to(DEVICE)
        attention_mask = batch["attention_mask"].to(DEVICE)

        logits = model(images, input_ids, attention_mask)
        probabilities = torch.softmax(logits, dim=1).cpu().numpy()
        predictions = probabilities.argmax(axis=1)

        for i, prediction in enumerate(predictions):
            true_label = int(batch["label"][i])
            rows.append({
                "sample_id": int(batch["sample_id"][i]),
                "image_name": batch["image_name"][i],
                "ground_truth": true_label,
                "ground_truth_name": "UAF" if true_label == 0 else "Non-UAF",
                "prediction": int(prediction),
                "prediction_name": "UAF" if prediction == 0 else "Non-UAF",
                "prob_uaf": float(probabilities[i, 0]),
                "prob_non_uaf": float(probabilities[i, 1])
            })

    pd.DataFrame(rows).to_csv(
        PRED_CSV, index=False, encoding="utf-8-sig"
    )
    logger.info("Predictions saved to %s", PRED_CSV)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--eval-only", action="store_true")
    parser.add_argument("--local-longformer", default="")
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    args = parser.parse_args()

    longformer_name = args.local_longformer.strip() or LONGFORMER_NAME

    logger.info("Device: %s", DEVICE)
    logger.info("Architecture: 6 Longformer + 4 MoBA")
    logger.info("MoBA: block=%d, top-k=%d, heads=%d, dropout=%.2f",
                MOBA_BLOCK_SIZE, MOBA_TOP_K,
                NUM_ATTENTION_HEADS, ATTENTION_DROPOUT)

    tokenizer = AutoTokenizer.from_pretrained(longformer_name)
    tokenizer.truncation_side = "right"

    train_dataset = UAFMultimodalDataset(
        IMG_ROOT, META_ROOT, CODE_ROOT, True,
        tokenizer, IMAGE_TRANSFORM
    )
    val_dataset = UAFMultimodalDataset(
        IMG_ROOT, META_ROOT, CODE_ROOT, False,
        tokenizer, IMAGE_TRANSFORM
    )

    train_loader = DataLoader(
        train_dataset, batch_size=args.batch_size, shuffle=True,
        num_workers=NUM_WORKERS, pin_memory=torch.cuda.is_available()
    )
    val_loader = DataLoader(
        val_dataset, batch_size=args.batch_size, shuffle=False,
        num_workers=NUM_WORKERS, pin_memory=torch.cuda.is_available()
    )

    model = MLGUAF6L4M(longformer_name).to(DEVICE)
    criterion = nn.CrossEntropyLoss()
    optimizer = optim.AdamW(
        model.parameters(),
        lr=LEARNING_RATE,
        weight_decay=WEIGHT_DECAY
    )

    logger.info("All model parameters trainable: %s",
                all(p.requires_grad for p in model.parameters()))

    if args.eval_only:
        if not os.path.isfile(BEST_CKPT):
            raise FileNotFoundError(BEST_CKPT)
        checkpoint = torch.load(BEST_CKPT, map_location=DEVICE)
        model.load_state_dict(checkpoint["model_state"])
    else:
        best_f1 = -1.0
        stale_epochs = 0

        for epoch in range(args.epochs):
            train_metrics = run_epoch(
                model, train_loader, criterion, optimizer,
                desc=f"Train {epoch + 1}/{args.epochs}"
            )
            val_metrics = run_epoch(
                model, val_loader, criterion, None,
                desc=f"Val {epoch + 1}/{args.epochs}"
            )

            logger.info(
                "Epoch %02d/%02d | train loss=%.4f acc=%.4f F1=%.4f | "
                "val loss=%.4f acc=%.4f precision=%.4f recall=%.4f F1=%.4f",
                epoch + 1, args.epochs,
                train_metrics["loss"], train_metrics["accuracy"],
                train_metrics["f1"],
                val_metrics["loss"], val_metrics["accuracy"],
                val_metrics["precision"], val_metrics["recall"],
                val_metrics["f1"]
            )

            if val_metrics["f1"] > best_f1:
                best_f1 = val_metrics["f1"]
                stale_epochs = 0
                torch.save({
                    "model_state": model.state_dict(),
                    "epoch": epoch + 1,
                    "best_val_f1": best_f1,
                    "seed": SEED,
                    "architecture": "6 Longformer + 4 MoBA",
                    "moba_block_size": MOBA_BLOCK_SIZE,
                    "moba_top_k": MOBA_TOP_K,
                    "num_attention_heads": NUM_ATTENTION_HEADS
                }, BEST_CKPT)
                logger.info("Saved checkpoint: %s", BEST_CKPT)
            else:
                stale_epochs += 1
                if stale_epochs >= PATIENCE:
                    logger.info("Early stopping after %d stale epochs", PATIENCE)
                    break

        checkpoint = torch.load(BEST_CKPT, map_location=DEVICE)
        model.load_state_dict(checkpoint["model_state"])
        logger.info(
            "Best epoch=%s, best validation F1=%.4f",
            checkpoint.get("epoch"),
            checkpoint.get("best_val_f1", float("nan"))
        )

    final_metrics = run_epoch(
        model, val_loader, criterion, None, desc="Final validation"
    )
    logger.info("Final validation metrics: %s", final_metrics)
    save_predictions(model, val_loader)


if __name__ == "__main__":
    main()
