import re
import matplotlib.pyplot as plt
import os


VAR_ID_MAP = {
    "set": 1,
    "rule": 2,
    "trans": 3
}


class UnionFind:
    """Union-Find (Disjoint Set Union) for pointer aliasing equivalence tracking."""
    def __init__(self):
        self.parent = dict()

    def add(self, elem):
        if elem not in self.parent:
            self.parent[elem] = elem

    def find(self, elem):
        if self.parent[elem] != elem:
            self.parent[elem] = self.find(self.parent[elem])
        return self.parent[elem]

    def union(self, x, y):
        self.add(x)
        self.add(y)
        rx = self.find(x)
        ry = self.find(y)
        if rx != ry:
            self.parent[ry] = rx


def filter_comments(text):
    """Remove single-line and multi-line C/C++ comments."""
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.DOTALL)
    text = re.sub(r"//.*?$", "", text, flags=re.MULTILINE)
    return text


def identify_functions(code):
    """Extract function names and their body boundaries."""
    funcs = []
    pat = r'(void|int|char|float|double|struct)\s+([A-Za-z_]\w*)\s*\([^)]*\)\s*\{'
    for m in re.finditer(pat, code):
        func_name = m.group(2)
        start_idx = m.end()
        funcs.append({
            "name": func_name,
            "start": start_idx
        })

    func_body_map = {}
    for f in funcs:
        pos = f["start"]
        brace = 1
        while pos < len(code) and brace > 0:
            if code[pos] == '{':
                brace += 1
            elif code[pos] == '}':
                brace -= 1
            pos += 1
        body = code[f["start"]:pos - 1]
        func_body_map[f["name"]] = body
    return funcs, func_body_map


def build_execution_flow(func_body_map, entry_list, pointer_map=None):
    """
    Generate static flattened execution trace by DFS traversal of call graph.
    This yields a single textual trace without branch feasibility checking.
    """
    if pointer_map is None:
        pointer_map = {}
    exec_list = []
    visited_func = set()

    def dfs(func_name):
        if func_name not in func_body_map or func_name in visited_func:
            return
        visited_func.add(func_name)
        body = func_body_map[func_name]
        lines = body.splitlines()
        for raw_line in lines:
            line = raw_line.strip()
            if not line:
                continue
            exec_list.append((func_name, line))
            calls = set()
            for m in re.finditer(r"\b([A-Za-z_]\w+)\s*\(", line):
                calls.add(m.group(1))
            for m in re.finditer(r"(?:->|\.)([A-Za-z_]\w+)\s*\(", line):
                calls.add(m.group(1))
            for callee in calls:
                dfs(callee)
                if callee in pointer_map:
                    real_func = pointer_map[callee]
                    dfs(real_func)

    for entry in entry_list:
        dfs(entry)
    return exec_list


def extract_malloc(line):
    """Extract allocation events: var = malloc / kvmalloc(...)"""
    pat = r"([A-Za-z_]\w+)\s*=\s*\(.*?\)?(malloc|kvmalloc)\s*\("
    res = []
    for m in re.findall(pat, line):
        var = m[0]
        res.append(f"malloc {var}")
    return res


def extract_free(line):
    """Extract free events: free / kfree / kvfree(var)"""
    pat = r"(kfree|kvfree|free)\s*\(\s*([A-Za-z_]\w+)\s*\)"
    match = re.search(pat, line)
    if match:
        free_var = match.group(2)
        return f"free {free_var}"
    return None


def extract_use_vars(line, blacklist, func_names):
    """Extract pointer-use events, exclude free statements and keywords."""
    use_feats = []
    line_clean = re.sub(r"\b(kfree|kvfree|free)\s*\([^)]*\)\s*;?", "", line)
    var_pat = r"\b([A-Za-z_]\w+(?:->|\.[A-Za-z_]\w+)*(?:\[\d*\])?)\b"
    all_matches = re.findall(var_pat, line_clean)
    unique_vars = set()
    for full_expr in all_matches:
        base_var = re.split(r"->|\.", full_expr)[0]
        if (base_var in blacklist or
            base_var in func_names or
            base_var not in VAR_ID_MAP):
            continue
        unique_vars.add(base_var)
    for v in unique_vars:
        use_feats.append(f"use {v}")
    return use_feats


def draw_uaf_flow(feature_list):
    """Plot memory operation sequence: circle=ALLOC, triangle=FREE, square=USE."""
    plt.figure(figsize=(16, 6))
    pos_map = {}
    shape_map = {}
    text_map = {}
    idx = 0
    for feat in feature_list:
        parts = feat.split()
        if len(parts) < 2:
            continue
        act, var = parts[0], parts[1]
        if var not in VAR_ID_MAP:
            continue
        if act == "malloc":
            shape = "circle"
        elif act == "free":
            shape = "triangle"
        elif act == "use":
            shape = "square"
        else:
            continue
        pos_map[idx] = (idx * 2, 0)
        shape_map[idx] = shape
        text_map[idx] = VAR_ID_MAP[var]
        idx += 1

    ax = plt.gca()
    for i in range(len(pos_map)):
        x, y = pos_map[i]
        s = shape_map[i]
        num = text_map[i]
        if s == "circle":
            circ = plt.Circle((x, y), 0.5, fc="lightcoral", ec="black")
            ax.add_patch(circ)
        elif s == "triangle":
            poly = plt.Polygon([[x - 0.5, y - 0.5], [x + 0.5, y - 0.5], [x, y + 0.5]], fc="lightgreen", ec="black")
            ax.add_patch(poly)
        elif s == "square":
            rect = plt.Rectangle((x - 0.5, y - 0.5), 1, 1, fc="lightblue", ec="black")
            ax.add_patch(rect)
        plt.text(x, y, str(num), ha="center", va="center", fontsize=12)
    plt.xlim(-1, len(pos_map) * 2)
    plt.ylim(-1, 1)
    plt.axis("off")
    plt.title("CVE-2023-32233: Full Memory Sequence (set=1, rule=2, trans=3)")
    plt.show()


def main():
    blacklist = {
        "int", "char", "float", "double", "void", "long", "short", "unsigned", "signed",
        "size_t", "u32", "NULL", "malloc", "kvmalloc", "kfree", "kvfree", "free", "sizeof",
        "NFT_MSG_DELRULE", "NFT_MSG_DELSETELEM", "struct", "static", "inline", "return", "break",
        "if", "switch", "case", "for", "while", "else", "expr", "ext", "priv", "msg_type", "data",
        "nft_set_ops", "nft_set_elem", "nft_set_ext", "nft_set", "nft_trans", "nft_rule",
        "nft_expr", "nft_lookup", "nft_trans_elem", "nf_tables_rule_destroy",
        "nft_trans_elem_set", "nf_tables_set_elem_destroy", "nft_set_elem_ext", "ops", "destroy",
        "name", "priv", "stale_set", "elem"
    }

    folder = r"D:\zhang\uaf"
    target_file = "papercode.txt"
    path = os.path.join(folder, target_file)
    with open(path, "r", encoding="utf-8") as f:
        raw_code = f.read()

    clean_code = filter_comments(raw_code)
    all_funcs, func_body_dict = identify_functions(clean_code)
    func_names = {f["name"] for f in all_funcs}

    pointer_dispatch = {
        "destroy": "nft_lookup_destroy"
    }

    entry_points = ["nft_commit_release"]
    exec_flow = build_execution_flow(func_body_dict, entry_points, pointer_dispatch)

    uf = UnionFind()
    freed_roots = set()
    all_features = []
    uaf_reports = []

    print("========== Execution Flow ==========")
    for func_name, line in exec_flow:
        print(f"[{func_name}] {line}")

        mallocs = extract_malloc(line)
        for evt in mallocs:
            _, var = evt.split()
            uf.add(var)
            all_features.append(evt)

        free_feat = extract_free(line)
        if free_feat is not None:
            _, var = free_feat.split()
            uf.add(var)
            root = uf.find(var)
            freed_roots.add(root)
            all_features.append(free_feat)

        uses = extract_use_vars(line, blacklist, func_names)
        for evt in uses:
            _, var = evt.split()
            uf.add(var)
            root = uf.find(var)
            if root in freed_roots:
                uaf_reports.append(f"UAF detected: alias set rooted at '{root}', accessed via '{var}'")
            all_features.append(evt)

    print("\n========== Clean Memory Operation Sequence ==========")
    for f in all_features:
        print(f)

    print("\n========== UAF Detection Result (Union-Find Alias Aware) ==========")
    if uaf_reports:
        for msg in uaf_reports:
            print(f"⚠️  {msg}")
    else:
        print("✅ No use-after-free detected.")

    draw_uaf_flow(all_features)


if __name__ == "__main__":
    main()
