# ============================================================
# Label Parser
# ============================================================
def resolve_label(image_name):
    if "-0-" in image_name:
        return 0
    if "-1-" in image_name:
        return 1
    return None


# ============================================================
# Dataset (Unchanged, compatible with previous baseline)
# ============================================================
class UAFMultimodalDataset(Dataset):
    def __init__(
        self,
        img_root,
        meta_root,
        code_root,
        is_train,
        tokenizer,
        transform,
        max_length=MAX_CODE_LENGTH
    ):
        self.img_paths = []
        self.code_paths = []
        self.labels = []
        self.image_names = []
        self.sample_ids = []
        self.tokenizer = tokenizer
        self.transform = transform
        self.max_length = max_length

        split_name = "train.txt" if is_train else "val.txt"
        split_file = os.path.join(meta_root, split_name)
        if not os.path.isfile(split_file):
            raise FileNotFoundError(f"Split file not found: {split_file}")

        missing_images = 0
        missing_codes = 0
        with open(split_file, "r", encoding="utf-8", errors="ignore") as f:
            for line_no, line in enumerate(f, start=1):
                line = line.strip()
                if not line:
                    continue
                image_name = line.split(",")[0].strip()
                label = resolve_label(image_name)
                if label is None:
                    logger.warning(
                        "Skipping unknown label pattern at %s:%d: %s",
                        split_file, line_no, image_name
                    )
                    continue
                image_path = os.path.join(img_root, "uaf", image_name)
                code_name = image_name.replace("gen", "").replace(".jpg", ".c")
                code_path = os.path.join(code_root, code_name)
                if not os.path.isfile(image_path):
                    missing_images += 1
                    logger.warning("Image missing: %s", image_path)
                    continue
                if not os.path.isfile(code_path):
                    missing_codes += 1
                    logger.warning("Code missing: %s", code_path)
                    continue
                self.img_paths.append(image_path)
                self.code_paths.append(code_path)
                self.labels.append(label)
                self.image_names.append(image_name)
                self.sample_ids.append(len(self.sample_ids) + 1)

        if not self.labels:
            raise ValueError(
                f"No valid image/code pairs found in {split_file}. "
                "Check paths, naming convention."
            )
        uaf_count = sum(label == 0 for label in self.labels)
        non_uaf_count = sum(label == 1 for label in self.labels)
        logger.info(
            "%s dataset: %d samples | UAF(label 0)=%d | Non-UAF(label 1)=%d | "
            "missing images=%d | missing code files=%d",
            "Train" if is_train else "Validation",
            len(self), uaf_count, non_uaf_count, missing_images, missing_codes
        )

    def __len__(self):
        return len(self.labels)

    def __getitem__(self, idx):
        image = Image.open(self.img_paths[idx]).convert("RGB")
        image_tensor = self.transform(image)
        with open(self.code_paths[idx], "r", encoding="utf-8", errors="ignore") as f:
            code_text = f.read()
        encoded = self.tokenizer(
            code_text,
            padding="max_length",
            truncation=True,
            max_length=self.max_length,
            return_tensors="pt"
        )
        return {
            "image": image_tensor,
            "input_ids": encoded["input_ids"].squeeze(0),
            "attention_mask": encoded["attention_mask"].squeeze(0),
            "label": torch.tensor(self.labels[idx], dtype=torch.long),
            "sample_id": self.sample_ids[idx],
            "image_name": self.image_names[idx],
        }


# ============================================================
# Image Preprocessing for ViT-B/16
# ============================================================
IMAGE_TRANSFORM = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.ToTensor(),
    transforms.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
])


# ============================================================
# MoBA Block Attention Module
# Mixture of Block Attention: route queries to local blocks + global block
# ============================================================
class MoBABlockAttention(nn.Module):
    def __init__(self, hidden_dim, block_size=MOBA_BLOCK_SIZE, dropout=0.1):
        super().__init__()
        self.block_size = block_size
        self.hidden_dim = hidden_dim
        self.qkv = nn.Linear(hidden_dim, hidden_dim * 3)
        self.out_proj = nn.Linear(hidden_dim, hidden_dim)
        self.drop = nn.Dropout(dropout)
        self.scale = (hidden_dim ** -0.5)

    def forward(self, x, attention_mask):
        B, L, C = x.shape
        qkv = self.qkv(x).reshape(B, L, 3, C).permute(2, 0, 1, 3)
        q, k, v = qkv[0], qkv[1], qkv[2]

        num_blocks = (L + self.block_size - 1) // self.block_size
        q_blocks = q.reshape(B, num_blocks, self.block_size, C)
        k_blocks = k.reshape(B, num_blocks, self.block_size, C)
        v_blocks = v.reshape(B, num_blocks, self.block_size, C)
        mask_blocks = attention_mask.reshape(B, num_blocks, self.block_size)

        attn_scores = torch.einsum("b n s c, b n t c -> b n s t", q_blocks, k_blocks) * self.scale
        mask_expand = mask_blocks.unsqueeze(-2) * mask_blocks.unsqueeze(-1)
        attn_scores = attn_scores.masked_fill(mask_expand == 0, -1e9)
        attn_weights = F.softmax(attn_scores, dim=-1)
        attn_weights = self.drop(attn_weights)

        out_blocks = torch.einsum("b n s t, b n t c -> b n s c", attn_weights, v_blocks)
        out = out_blocks.reshape(B, L, C)
        out = self.out_proj(out)
        out = self.drop(out)
        return out


# ============================================================
# MoBA-Longformer Wrapper
# Replace standard attention layers of Longformer with MoBA block attention
# ============================================================
class MoBALongformer(nn.Module):
    def __init__(self, longformer_name, block_size=MOBA_BLOCK_SIZE):
        super().__init__()
        self.backbone = LongformerModel.from_pretrained(longformer_name)
        self.hidden_size = self.backbone.config.hidden_size
        self.num_layers = self.backbone.config.num_hidden_layers
        self.moba_attn = nn.ModuleList([
            MoBABlockAttention(self.hidden_size, block_size)
            for _ in range(self.num_layers)
        ])

    def forward(self, input_ids, attention_mask):
        outputs = self.backbone(
            input_ids=input_ids,
            attention_mask=attention_mask,
            output_hidden_states=True
        )
        hidden_states = outputs.hidden_states
        x = hidden_states[0]
        for layer_idx in range(self.num_layers):
            x = self.moba_attn[layer_idx](x, attention_mask) + hidden_states[layer_idx + 1]
        return x


# ============================================================
# Full Model: ViT + MoBA-Longformer + Projection + MLP Fusion
# Matches the diagram
# ============================================================
class MLGViTMoBALongformerFusion(nn.Module):
    def __init__(
        self,
        longformer_name=LONGFORMER_NAME,
        projection_dim=PROJECTION_DIM,
        dropout=DROPOUT,
        pretrained_vit=True
    ):
        super().__init__()
        # Image Encoder: ViT-B/16
        weights = ViT_B_16_Weights.DEFAULT if pretrained_vit else None
        self.vit = vit_b_16(weights=weights)
        vit_dim = self.vit.heads.head.in_features
        self.vit.heads = nn.Identity()

        # Code Encoder: MoBA-Longformer
        self.moba_longformer = MoBALongformer(longformer_name)
        code_hidden_dim = self.moba_longformer.hidden_size

        # Projection Heads (768 -> 512, LN + GELU + Drop)
        self.image_projection = nn.Sequential(
            nn.Linear(vit_dim, projection_dim),
            nn.LayerNorm(projection_dim),
            nn.GELU(),
            nn.Dropout(dropout),
        )
        self.code_projection = nn.Sequential(
            nn.Linear(code_hidden_dim, projection_dim),
            nn.LayerNorm(projection_dim),
            nn.GELU(),
            nn.Dropout(dropout),
        )

        # MLP Fusion Module: 1024 -> 512 -> 256 -> 2
        self.fusion_mlp = nn.Sequential(
            nn.Linear(projection_dim * 2, 512),
            nn.LayerNorm(512),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(512, 256),
            nn.LayerNorm(256),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(256, NUM_CLASSES),
        )

    def forward(self, images, input_ids, attention_mask):
        # Image branch
        img_raw = self.vit(images)
        img_feat = self.image_projection(img_raw)

        # Code branch: MoBA-Longformer + Masked Mean Pooling
        token_states = self.moba_longformer(input_ids, attention_mask)
        mask = attention_mask.unsqueeze(-1).to(token_states.dtype)
        code_raw = (token_states * mask).sum(dim=1) / mask.sum(dim=1).clamp(min=1.0)
        code_feat = self.code_projection(code_raw)

        # Concatenate two 512-D features to get 1024-D fused feature
        fused = torch.cat([img_feat, code_feat], dim=1)
        logits = self.fusion_mlp(fused)
        return logits


# ============================================================
# Train / Val Epoch Function
# ============================================================
def run_epoch(
    model,
    loader,
    criterion,
    optimizer=None,
    desc=""
):
    training = optimizer is not None
    model.train(training)
    total_loss = 0.0
    y_true = []
    y_pred = []
    correct = 0
    total_samples = 0
    with torch.set_grad_enabled(training):
        pbar = tqdm(loader, desc=desc, leave=False)
        for batch in pbar:
            images = batch["image"].to(DEVICE)
            input_ids = batch["input_ids"].to(DEVICE)
            attention_mask = batch["attention_mask"].to(DEVICE)
            labels = batch["label"].to(DEVICE)
            batch_size = labels.size(0)
            if training:
                optimizer.zero_grad(set_to_none=True)
            logits = model(images, input_ids, attention_mask)
            loss = criterion(logits, labels)
            if training:
                loss.backward()
                torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
                optimizer.step()
            total_loss += loss.item()
            preds = logits.argmax(dim=1)
            correct += (preds == labels).sum().item()
            total_samples += batch_size
            current_acc = correct / total_samples
            y_pred.extend(preds.detach().cpu().tolist())
            y_true.extend(labels.detach().cpu().tolist())
            pbar.set_postfix({
                "loss": f"{loss.item():.4f}",
                "acc": f"{current_acc:.4f}"
            })
    metrics = {
        "loss": total_loss / max(1, len(loader)),
        "accuracy": accuracy_score(y_true, y_pred),
        "precision": precision_score(y_true, y_pred, average="weighted", zero_division=0),
        "recall": recall_score(y_true, y_pred, average="weighted", zero_division=0),
        "f1": f1_score(y_true, y_pred, average="weighted", zero_division=0),
    }
    return metrics


# ============================================================
# Save Validation Predictions CSV
# ============================================================
def save_predictions(model, loader):
    model.eval()
    rows = []
    with torch.no_grad():
        for batch in tqdm(loader, desc="Predict", leave=False):
            images = batch["image"].to(DEVICE)
            input_ids = batch["input_ids"].to(DEVICE)
            attention_mask = batch["attention_mask"].to(DEVICE)
            logits = model(images, input_ids, attention_mask)
            probabilities = torch.softmax(logits, dim=1).cpu().numpy()
            predictions = probabilities.argmax(axis=1)
            for i, prediction in enumerate(predictions):
                true_label = int(batch["label"][i])
                rows.append({
                    "sample_id": int(batch["sample_id"][i]),
                    "image_name": batch["image_name"][i],
                    "ground_truth": true_label,
                    "ground_truth_name": "UAF" if true_label == 0 else "Non-UAF",
                    "prediction": int(prediction),
                    "prediction_name": "UAF" if prediction == 0 else "Non-UAF",
                    "prob_uaf": float(probabilities[i, 0]),
                    "prob_non_uaf": float(probabilities[i, 1]),
                })
    pd.DataFrame(rows).to_csv(PRED_CSV, index=False, encoding="utf-8-sig")
    logger.info("Predictions saved to %s", PRED_CSV)


# ============================================================
# Main Training Pipeline
# ============================================================
def main():
    longformer_name = args.local_longformer.strip() or LONGFORMER_NAME
    logger.info("Device: %s", DEVICE)
    logger.info("Image root: %s/uaf", IMG_ROOT)
    logger.info("Metadata root: %s", META_ROOT)
    logger.info("Code root: %s", CODE_ROOT)
    logger.info("Output root: %s", OUTPUT_DIR)
    logger.info("Label convention: 0=UAF, 1=Non-UAF")

    tokenizer = AutoTokenizer.from_pretrained(longformer_name)
    train_dataset = UAFMultimodalDataset(
        IMG_ROOT, META_ROOT, CODE_ROOT, True, tokenizer, IMAGE_TRANSFORM
    )
    val_dataset = UAFMultimodalDataset(
        IMG_ROOT, META_ROOT, CODE_ROOT, False, tokenizer, IMAGE_TRANSFORM
    )
    train_loader = DataLoader(
        train_dataset, batch_size=BATCH_SIZE, shuffle=True,
        num_workers=NUM_WORKERS, pin_memory=torch.cuda.is_available()
    )
    val_loader = DataLoader(
        val_dataset, batch_size=BATCH_SIZE, shuffle=False,
        num_workers=NUM_WORKERS, pin_memory=torch.cuda.is_available()
    )
    model = MLGViTMoBALongformerFusion(longformer_name=longformer_name).to(DEVICE)
    criterion = nn.CrossEntropyLoss()
    optimizer = optim.AdamW(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)

    if args.eval_only:
        if not os.path.isfile(BEST_CKPT):
            raise FileNotFoundError(f"Checkpoint not found: {BEST_CKPT}")
        checkpoint = torch.load(BEST_CKPT, map_location=DEVICE)
        model.load_state_dict(checkpoint["model_state"])
    else:
        best_f1 = -1.0
        stale_epochs = 0
        for epoch in range(EPOCHS):
            train_metrics = run_epoch(
                model, train_loader, criterion, optimizer, desc=f"Train {epoch + 1}/{EPOCHS}"
            )
            val_metrics = run_epoch(
                model, val_loader, criterion, None, desc=f"Val {epoch + 1}/{EPOCHS}"
            )
            logger.info(
                "Epoch %02d/%02d | train loss=%.4f acc=%.4f F1=%.4f | "
                "val loss=%.4f acc=%.4f precision=%.4f recall=%.4f F1=%.4f",
                epoch + 1, EPOCHS,
                train_metrics["loss"], train_metrics["accuracy"], train_metrics["f1"],
                val_metrics["loss"], val_metrics["accuracy"],
                val_metrics["precision"], val_metrics["recall"], val_metrics["f1"]
            )
            if val_metrics["f1"] > best_f1:
                best_f1 = val_metrics["f1"]
                stale_epochs = 0
                torch.save({
                    "model_state": model.state_dict(),
                    "epoch": epoch + 1,
                    "best_val_f1": best_f1,
                    "label_mapping": {"0": "UAF", "1": "Non-UAF"},
                }, BEST_CKPT)
                logger.info("Saved best checkpoint: %s", BEST_CKPT)
            else:
                stale_epochs += 1
                if stale_epochs >= PATIENCE:
                    logger.info("Early stopping after %d stale epochs", PATIENCE)
                    break
        checkpoint = torch.load(BEST_CKPT, map_location=DEVICE)
        model.load_state_dict(checkpoint["model_state"])
        logger.info("Best epoch=%s, best validation F1=%.4f",
                    checkpoint.get("epoch"), checkpoint.get("best_val_f1", float("nan")))

    val_metrics = run_epoch(model, val_loader, criterion, None, desc="Final validation")
    logger.info("Final validation metrics: %s", val_metrics)
    save_predictions(model, val_loader)


if __name__ == "__main__":
    main()
