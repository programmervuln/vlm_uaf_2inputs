class LocalSlidingWindowAttention(nn.Module):
    def __init__(self, hidden_size, num_heads, window_size=64, dropout=0.1):
        super().__init__()
        if hidden_size % num_heads != 0:
            raise ValueError("hidden_size must be divisible by num_heads")
        self.num_heads = num_heads
        self.head_dim = hidden_size // num_heads
        self.window_size = window_size
        self.qkv = nn.Linear(hidden_size, hidden_size * 3)
        self.out_proj = nn.Linear(hidden_size, hidden_size)
        self.attn_dropout = nn.Dropout(dropout)
        self.proj_dropout = nn.Dropout(dropout)

    def forward(self, x, attention_mask):
        batch_size, seq_len, hidden_size = x.shape
        qkv = self.qkv(x).view(
            batch_size, seq_len, 3, self.num_heads, self.head_dim
        )
        q, k, v = qkv.unbind(dim=2)
        q = q.transpose(1, 2)
        k = k.transpose(1, 2)
        v = v.transpose(1, 2)

        left = (self.window_size - 1) // 2
        right = self.window_size - 1 - left
        k_pad = nn.functional.pad(k, (0, 0, left, right))
        v_pad = nn.functional.pad(v, (0, 0, left, right))

        positions = torch.arange(seq_len, device=x.device)
        offsets = torch.arange(self.window_size, device=x.device)
        gather_positions = positions[:, None] + offsets[None, :]
        valid_positions = (gather_positions >= left) & (gather_positions < left + seq_len)
        gather_positions = gather_positions.reshape(-1)

        k_local = k_pad.index_select(2, gather_positions).view(
            batch_size, self.num_heads, seq_len, self.window_size, self.head_dim
        )
        v_local = v_pad.index_select(2, gather_positions).view_as(k_local)

        key_mask = attention_mask.bool()
        key_mask_pad = nn.functional.pad(key_mask, (left, right), value=False)
        local_key_mask = key_mask_pad.index_select(
            1, (positions[:, None] + offsets[None, :]).reshape(-1)
        ).view(batch_size, seq_len, self.window_size)

        local_mask = valid_positions.unsqueeze(0) & local_key_mask
        scores = torch.einsum("bhld,bhlwd->bhlw", q, k_local)
        scores = scores / (self.head_dim ** 0.5)
        scores = scores.masked_fill(
            ~local_mask.unsqueeze(1), torch.finfo(scores.dtype).min
        )
        weights = torch.softmax(scores, dim=-1)
        weights = self.attn_dropout(weights)
        context = torch.einsum("bhlw,bhlwd->bhld", weights, v_local)
        context = context.transpose(1, 2).contiguous().view(
            batch_size, seq_len, hidden_size
        )
        return self.proj_dropout(self.out_proj(context))


class MoBADynamicRoutingAttention(nn.Module):
    def __init__(
        self, hidden_size, num_heads, block_size=64, top_k=2,
        dropout=0.1, query_chunk_size=32
    ):
        super().__init__()
        if hidden_size % num_heads != 0:
            raise ValueError("hidden_size must be divisible by num_heads")
        self.num_heads = num_heads
        self.head_dim = hidden_size // num_heads
        self.block_size = block_size
        self.top_k = top_k
        self.query_chunk_size = query_chunk_size
        self.qkv = nn.Linear(hidden_size, hidden_size * 3)
        self.out_proj = nn.Linear(hidden_size, hidden_size)
        self.attn_dropout = nn.Dropout(dropout)
        self.proj_dropout = nn.Dropout(dropout)

    def forward(self, x, attention_mask):
        batch_size, seq_len, hidden_size = x.shape
        qkv = self.qkv(x).view(
            batch_size, seq_len, 3, self.num_heads, self.head_dim
        )
        q, k, v = qkv.unbind(dim=2)
        q = q.transpose(1, 2)
        k = k.transpose(1, 2)
        v = v.transpose(1, 2)

        pad_len = (-seq_len) % self.block_size
        if pad_len:
            k_pad = nn.functional.pad(k, (0, 0, 0, pad_len))
            v_pad = nn.functional.pad(v, (0, 0, 0, pad_len))
            mask_pad = nn.functional.pad(
                attention_mask.bool(), (0, pad_len), value=False
            )
        else:
            k_pad, v_pad = k, v
            mask_pad = attention_mask.bool()

        padded_len = k_pad.size(2)
        num_blocks = padded_len // self.block_size
        k_blocks = k_pad.view(
            batch_size, self.num_heads, num_blocks, self.block_size, self.head_dim
        )
        v_blocks = v_pad.view_as(k_blocks)
        mask_blocks = mask_pad.view(batch_size, num_blocks, self.block_size)

        block_mask = mask_blocks.unsqueeze(1).unsqueeze(-1).to(k_blocks.dtype)
        block_sum = (k_blocks * block_mask).sum(dim=3)
        block_count = mask_blocks.sum(dim=-1).clamp(min=1).to(k_blocks.dtype)
        block_keys = block_sum / block_count[:, None, :, None]
        block_valid = mask_blocks.any(dim=-1)

        routing_scores = torch.einsum("bhld,bhnd->bhln", q, block_keys)
        routing_scores = routing_scores / (self.head_dim ** 0.5)
        routing_scores = routing_scores.masked_fill(
            ~block_valid[:, None, None, :],
            torch.finfo(routing_scores.dtype).min
        )
        k_select = min(self.top_k, num_blocks)
        selected_blocks = torch.topk(
            routing_scores, k=k_select, dim=-1
        ).indices

        k_flat = k_pad
        v_flat = v_pad
        outputs = []
        token_offsets = torch.arange(
            self.block_size, device=x.device
        ).view(1, 1, 1, 1, self.block_size)

        batch_index = torch.arange(batch_size, device=x.device).view(
            batch_size, 1, 1, 1
        )
        head_index = torch.arange(self.num_heads, device=x.device).view(
            1, self.num_heads, 1, 1
        )

        for q_start in range(0, seq_len, self.query_chunk_size):
            q_end = min(q_start + self.query_chunk_size, seq_len)
            q_chunk = q[:, :, q_start:q_end, :]
            block_idx = selected_blocks[:, :, q_start:q_end, :]
            token_idx = (
                block_idx.unsqueeze(-1) * self.block_size
                + token_offsets
            ).reshape(
                batch_size, self.num_heads,
                q_end - q_start, k_select * self.block_size
            )

            k_selected = k_flat[
                batch_index, head_index, token_idx
            ]
            v_selected = v_flat[
                batch_index, head_index, token_idx
            ]

            selected_mask = mask_pad[
                batch_index[:, 0, 0, 0].view(batch_size, 1, 1, 1),
                token_idx
            ]
            scores = torch.einsum(
                "bhqd,bhqkd->bhqk", q_chunk, k_selected
            ) / (self.head_dim ** 0.5)
            scores = scores.masked_fill(
                ~selected_mask, torch.finfo(scores.dtype).min
            )
            weights = torch.softmax(scores, dim=-1)
            weights = self.attn_dropout(weights)
            context = torch.einsum(
                "bhqk,bhqkd->bhqd", weights, v_selected
            )
            outputs.append(context)

        context = torch.cat(outputs, dim=2)
        context = context.transpose(1, 2).contiguous().view(
            batch_size, seq_len, hidden_size
        )
        return self.proj_dropout(self.out_proj(context))


class SparseEncoderLayer(nn.Module):
    def __init__(
        self, hidden_size, num_heads, attention_type,
        window_size=64, block_size=64, top_k=2, dropout=0.1
    ):
        super().__init__()
        if attention_type == "local":
            self.attention = LocalSlidingWindowAttention(
                hidden_size, num_heads, window_size, dropout
            )
        elif attention_type == "moba":
            self.attention = MoBADynamicRoutingAttention(
                hidden_size, num_heads, block_size, top_k, dropout
            )
        else:
            raise ValueError(f"Unknown attention_type: {attention_type}")

        self.norm1 = nn.LayerNorm(hidden_size)
        self.norm2 = nn.LayerNorm(hidden_size)
        self.ffn = nn.Sequential(
            nn.Linear(hidden_size, hidden_size * 4),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(hidden_size * 4, hidden_size),
            nn.Dropout(dropout),
        )

    def forward(self, x, attention_mask):
        x = x + self.attention(self.norm1(x), attention_mask)
        x = x + self.ffn(self.norm2(x))
        return x


class MoBALongformerEnhancer(nn.Module):
    def __init__(
        self, hidden_size, num_heads=12, local_layers=6, moba_layers=4,
        window_size=64, block_size=64, top_k=2, dropout=0.1
    ):
        super().__init__()
        self.layers = nn.ModuleList()
        for _ in range(local_layers):
            self.layers.append(
                SparseEncoderLayer(
                    hidden_size, num_heads, "local",
                    window_size=window_size, dropout=dropout
                )
            )
        for _ in range(moba_layers):
            self.layers.append(
                SparseEncoderLayer(
                    hidden_size, num_heads, "moba",
                    block_size=block_size, top_k=top_k, dropout=dropout
                )
            )
        self.final_norm = nn.LayerNorm(hidden_size)

    def forward(self, token_states, attention_mask):
        x = token_states
        for layer in self.layers:
            x = layer(x, attention_mask)
        return self.final_norm(x)


class MLPFusionViTCodeBERT(nn.Module):
    def __init__(
        self,
        codebert_name=CODEBERT_NAME,
        projection_dim=PROJECTION_DIM,
        dropout=DROPOUT,
        pretrained_vit=True
    ):
        super().__init__()

        weights = (
            ViT_B_16_Weights.DEFAULT if pretrained_vit else None
        )
        self.vit = vit_b_16(weights=weights)
        vit_dim = self.vit.heads.head.in_features
        self.vit.heads = nn.Identity()

        self.codebert = AutoModel.from_pretrained(codebert_name)
        code_dim = self.codebert.config.hidden_size

        self.code_enhancer = MoBALongformerEnhancer(
            hidden_size=code_dim,
            num_heads=ATTENTION_HEADS,
            local_layers=LOCAL_LAYERS,
            moba_layers=MOBA_LAYERS,
            window_size=SLIDING_WINDOW,
            block_size=MOBA_BLOCK_SIZE,
            top_k=MOBA_TOP_K,
            dropout=ATTENTION_DROPOUT,
        )

        self.image_projection = nn.Sequential(
            nn.Linear(vit_dim, projection_dim),
            nn.LayerNorm(projection_dim),
            nn.GELU(),
            nn.Dropout(dropout),
        )

        self.code_projection = nn.Sequential(
            nn.Linear(code_dim, projection_dim),
            nn.LayerNorm(projection_dim),
            nn.GELU(),
            nn.Dropout(dropout),
        )

        self.fusion_mlp = nn.Sequential(
            nn.Linear(projection_dim * 2, 512),
            nn.LayerNorm(512),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(512, 256),
            nn.LayerNorm(256),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(256, NUM_CLASSES),
        )

    def forward(self, images, input_ids, attention_mask):
        image_raw = self.vit(images)
        image_feat = self.image_projection(image_raw)

        code_outputs = self.codebert(
            input_ids=input_ids,
            attention_mask=attention_mask
        )
        token_states = code_outputs.last_hidden_state

        enhanced_states = self.code_enhancer(
            token_states, attention_mask
        )

        mask = attention_mask.unsqueeze(-1).to(enhanced_states.dtype)
        code_raw = (
            (enhanced_states * mask).sum(dim=1)
            / mask.sum(dim=1).clamp(min=1.0)
        )
        code_feat = self.code_projection(code_raw)

        fused = torch.cat([image_feat, code_feat], dim=1)
        logits = self.fusion_mlp(fused)
        return logits


