# 9. Training & Evaluation
# ============================================================

def run_epoch(
    model,
    loader,
    criterion,
    optimizer=None,
    desc=""
):
    training = optimizer is not None
    model.train(training)

    total_loss = 0.0
    y_true = []
    y_pred = []
    correct = 0
    total_samples = 0

    with torch.set_grad_enabled(training):
        pbar = tqdm(loader, desc=desc, leave=False)
        for batch in pbar:
            images = batch["image"].to(DEVICE)
            input_ids = batch["input_ids"].to(DEVICE)
            attention_mask = batch["attention_mask"].to(DEVICE)
            labels = batch["label"].to(DEVICE)
            batch_size = labels.size(0)

            if training:
                optimizer.zero_grad(set_to_none=True)

            logits = model(images, input_ids, attention_mask)
            loss = criterion(logits, labels)

            if training:
                loss.backward()
                torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
                optimizer.step()

            total_loss += loss.item()
            preds = logits.argmax(dim=1)
            correct += (preds == labels).sum().item()
            total_samples += batch_size
            current_acc = correct / total_samples

            y_pred.extend(preds.detach().cpu().tolist())
            y_true.extend(labels.detach().cpu().tolist())

            pbar.set_postfix({
                "loss": f"{loss.item():.4f}",
                "acc": f"{current_acc:.4f}"
            })

    metrics = {
        "loss": total_loss / max(1, len(loader)),
        "accuracy": accuracy_score(y_true, y_pred),
        "precision": precision_score(y_true, y_pred, average="weighted", zero_division=0),
        "recall": recall_score(y_true, y_pred, average="weighted", zero_division=0),
        "f1": f1_score(y_true, y_pred, average="weighted", zero_division=0),
        "y_true": y_true,
        "y_pred": y_pred
    }
    return metrics


def save_predictions(model, loader, csv_path):
    model.eval()
    rows = []
    with torch.no_grad():
        for batch in tqdm(loader, desc="Predict", leave=False):
            images = batch["image"].to(DEVICE)
            input_ids = batch["input_ids"].to(DEVICE)
            attention_mask = batch["attention_mask"].to(DEVICE)
            logits = model(images, input_ids, attention_mask)
            probabilities = torch.softmax(logits, dim=1).cpu().numpy()
            predictions = probabilities.argmax(axis=1)

            for i, prediction in enumerate(predictions):
                true_label = int(batch["label"][i])
                rows.append({
                    "sample_id": int(batch["sample_id"][i]),
                    "image_name": batch["image_name"][i],
                    "group_id": batch["group_id"][i],
                    "ground_truth": true_label,
                    "ground_truth_name": "UAF" if true_label == 0 else "Non-UAF",
                    "prediction": int(prediction),
                    "prediction_name": "UAF" if prediction == 0 else "Non-UAF",
                    "prob_uaf": float(probabilities[i, 0]),
                    "prob_non_uaf": float(probabilities[i, 1]),
                })
    pd.DataFrame(rows).to_csv(csv_path, index=False, encoding="utf-8-sig")
    logger.info("Predictions saved to %s", csv_path)


def evaluate_on_dataset(model, tokenizer, split_name):
    ds = UAFMultimodalDataset(
        IMG_ROOT, META_ROOT, CODE_ROOT, split_name, tokenizer, IMAGE_TRANSFORM
    )
    dl = DataLoader(
        ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS,
        pin_memory=torch.cuda.is_available()
    )
    metrics = run_epoch(model, dl, nn.CrossEntropyLoss(), desc=f"Eval {split_name}")
    return metrics


# ============================================================
# 10. Wilcoxon Test
# ============================================================

def run_wilcoxon_test(score_dict, baseline_key="baseline"):
    results = {}
    baseline_scores = np.array(score_dict[baseline_key])
    for k, scores in score_dict.items():
        if k == baseline_key:
            continue
        stat, pval = wilcoxon(baseline_scores, np.array(scores))
        results[k] = {"statistic": stat, "pvalue": pval}
    return results


# ============================================================
# 11. Main
# ============================================================

def main():
    codebert_name = args.local_codebert.strip() or CODEBERT_NAME
    logger.info("Device: %s", DEVICE)
    logger.info("Image root: %s/uaf", IMG_ROOT)
    logger.info("Metadata root: %s", META_ROOT)
    logger.info("Code root: %s", CODE_ROOT)
    logger.info("Output root: %s", OUTPUT_DIR)
    logger.info("Label convention: 0=UAF, 1=Non-UAF")
    logger.info("N-Fold: %d, group-aware CV", N_FOLD)

    tokenizer = AutoTokenizer.from_pretrained(codebert_name)

    # use train.txt as the main pool for group k-fold
    full_train_ds = UAFMultimodalDataset(
        IMG_ROOT, META_ROOT, CODE_ROOT, "train.txt", tokenizer, IMAGE_TRANSFORM
    )
    groups = full_train_ds.get_groups()
    gkf = GroupKFold(n_splits=N_FOLD)
    fold_metrics_list = []
    dataset_cv_scores = defaultdict(list)

    for fold_idx, (train_idx, val_idx) in enumerate(gkf.split(np.arange(len(full_train_ds)), groups=groups)):
        fold = fold_idx + 1
        logger.info("===== Fold %d/%d =====", fold, N_FOLD)
        train_subset = Subset(full_train_ds, train_idx)
        val_subset = Subset(full_train_ds, val_idx)
        train_loader = DataLoader(
            train_subset, batch_size=BATCH_SIZE, shuffle=True, num_workers=NUM_WORKERS,
            pin_memory=torch.cuda.is_available()
        )
        val_loader = DataLoader(
            val_subset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS,
            pin_memory=torch.cuda.is_available()
        )

        model = MLPFusionViTCodeBERT(codebert_name=codebert_name).to(DEVICE)
        criterion = nn.CrossEntropyLoss()
        optimizer = optim.AdamW(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)
        ckpt_path = BEST_CKPT_TPL.format(fold=fold)
        pred_csv = PRED_CSV_TPL.format(fold=fold)

        if args.eval_only:
            if not os.path.isfile(ckpt_path):
                raise FileNotFoundError(f"Fold checkpoint not found: {ckpt_path}")
            checkpoint = torch.load(ckpt_path, map_location=DEVICE)
            model.load_state_dict(checkpoint["model_state"])
        else:
            best_f1 = -1.0
            stale_epochs = 0
            for epoch in range(EPOCHS):
                train_metrics = run_epoch(
                    model, train_loader, criterion, optimizer, desc=f"Fold{fold} Train {epoch+1}/{EPOCHS}"
                )
                val_metrics = run_epoch(
                    model, val_loader, criterion, None, desc=f"Fold{fold} Val {epoch+1}/{EPOCHS}"
                )
                logger.info(
                    "Fold %d Epoch %02d | train loss=%.4f acc=%.4f F1=%.4f | val loss=%.4f acc=%.4f prec=%.4f rec=%.4f F1=%.4f",
                    fold, epoch+1,
                    train_metrics["loss"], train_metrics["accuracy"], train_metrics["f1"],
                    val_metrics["loss"], val_metrics["accuracy"], val_metrics["precision"],
                    val_metrics["recall"], val_metrics["f1"]
                )
                if val_metrics["f1"] > best_f1:
                    best_f1 = val_metrics["f1"]
                    stale_epochs = 0
                    torch.save({
                        "model_state": model.state_dict(),
                        "epoch": epoch+1,
                        "best_val_f1": best_f1,
                        "label_mapping": {"0": "UAF", "1": "Non-UAF"}
                    }, ckpt_path)
                    logger.info("Fold %d saved best checkpoint: %s", fold, ckpt_path)
                else:
                    stale_epochs += 1
                    if stale_epochs >= PATIENCE:
                        logger.info("Fold %d early stop", fold)
                        break
            checkpoint = torch.load(ckpt_path, map_location=DEVICE)
            model.load_state_dict(checkpoint["model_state"])
            logger.info("Fold %d best epoch=%s, best val F1=%.4f", fold, checkpoint.get("epoch"), checkpoint.get("best_val_f1"))

        # eval on fold val subset
        final_val_metrics = run_epoch(model, val_loader, criterion, desc=f"Fold {fold} Final Val")
        save_predictions(model, val_loader, pred_csv)
        fold_metrics_list.append({
            "fold": fold,
            "val_loss": final_val_metrics["loss"],
            "val_acc": final_val_metrics["accuracy"],
            "val_prec": final_val_metrics["precision"],
            "val_recall": final_val_metrics["recall"],
            "val_f1": final_val_metrics["f1"]
        })

        # independent dataset evaluation
        for ds_name in DATASET_LIST:
            split_fn = f"{ds_name}.txt"
            try:
                ds_metrics = evaluate_on_dataset(model, tokenizer, split_fn)
                dataset_cv_scores[ds_name].append(ds_metrics["f1"])
                logger.info("Fold %d %s | acc=%.4f prec=%.4f rec=%.4f f1=%.4f",
                            fold, ds_name, ds_metrics["accuracy"], ds_metrics["precision"],
                            ds_metrics["recall"], ds_metrics["f1"])
            except Exception as e:
                logger.warning("Skip dataset %s: %s", ds_name, str(e))

    # aggregate CV metrics
    df_fold = pd.DataFrame(fold_metrics_list)
    df_fold.to_csv(os.path.join(OUTPUT_DIR, "fold_summary.csv"), index=False)
    logger.info("\n===== Cross Validation Summary =====")
    logger.info(df_fold.describe())

    # dataset aggregated result
    agg_rows = []
    for ds_name, f1_list in dataset_cv_scores.items():
        if len(f1_list) == 0:
            continue
        agg_rows.append({
            "dataset": ds_name,
            "f1_mean": np.mean(f1_list),
            "f1_std": np.std(f1_list),
            "f1_list": f1_list
        })
    df_ds = pd.DataFrame(agg_rows)
    df_ds.to_csv(os.path.join(OUTPUT_DIR, "dataset_summary.csv"), index=False)
    logger.info("\n===== Independent Dataset Summary =====")
    logger.info(df_ds)

    # Wilcoxon signed-rank test
    if args.run_wilcoxon:
        # you can replace baseline with your baseline method's score list
        wilcoxon_result = run_wilcoxon_test(dataset_cv_scores, baseline_key="Juliet")
        pd.DataFrame.from_dict(wilcoxon_result, orient="index").to_csv(
            os.path.join(OUTPUT_DIR, "wilcoxon_result.csv")
        )
        logger.info("\n===== Wilcoxon Signed-Rank Test =====")
        logger.info(wilcoxon_result)


if __name__ == "__main__":
    main()
