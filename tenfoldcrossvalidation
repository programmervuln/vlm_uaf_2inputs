def resolve_label(image_name):
    if "-0-" in image_name:
        return 0
    if "-1-" in image_name:
        return 1
    return None


# ============================================================
# 6. UAF multimodal dataset
# ============================================================

class UAFMultimodalDataset(Dataset):

    def __init__(
        self,
        img_root,
        meta_root,
        code_root,
        split_name,
        tokenizer,
        transform,
        max_length=MAX_CODE_LENGTH
    ):
        self.img_paths = []
        self.code_paths = []
        self.labels = []
        self.image_names = []
        self.sample_ids = []
        self.group_ids = []

        self.tokenizer = tokenizer
        self.transform = transform
        self.max_length = max_length

        split_file = os.path.join(meta_root, split_name)

        if not os.path.isfile(split_file):
            raise FileNotFoundError(f"Split file not found: {split_file}")

        missing_images = 0
        missing_codes = 0

        with open(
            split_file,
            "r",
            encoding="utf-8",
            errors="ignore"
        ) as f:
            for line_no, line in enumerate(f, start=1):
                line = line.strip()
                if not line:
                    continue
                tokens = line.split(",")
                image_name = tokens[0].strip()
                group_id = tokens[1].strip() if len(tokens)>=2 else image_name

                label = resolve_label(image_name)
                if label is None:
                    logger.warning(
                        "Skipping unknown label pattern at %s:%d: %s",
                        split_file, line_no, image_name
                    )
                    continue

                image_path = os.path.join(img_root, "uaf", image_name)
                code_name = image_name.replace("gen", "").replace(".jpg", ".c")
                code_path = os.path.join(code_root, code_name)

                if not os.path.isfile(image_path):
                    missing_images += 1
                    logger.warning("Image missing: %s", image_path)
                    continue
                if not os.path.isfile(code_path):
                    missing_codes += 1
                    logger.warning("Code missing: %s", code_path)
                    continue

                self.img_paths.append(image_path)
                self.code_paths.append(code_path)
                self.labels.append(label)
                self.image_names.append(image_name)
                self.group_ids.append(group_id)
                self.sample_ids.append(len(self.sample_ids)+1)

        if not self.labels:
            raise ValueError(
                f"No valid image/code pairs found in {split_file}. "
                "Check IMG_ROOT, META_ROOT, CODE_ROOT, filenames, and image-to-code naming."
            )

        uaf_count = sum(label == 0 for label in self.labels)
        non_uaf_count = sum(label == 1 for label in self.labels)

        logger.info(
            "%s dataset: %d samples | UAF(label 0)=%d | Non-UAF(label 1)=%d | "
            "missing images=%d | missing code files=%d",
            split_name, len(self), uaf_count, non_uaf_count, missing_images, missing_codes
        )

    def __len__(self):
        return len(self.labels)

    def __getitem__(self, idx):
        image = Image.open(self.img_paths[idx]).convert("RGB")
        image_tensor = self.transform(image)

        with open(
            self.code_paths[idx],
            "r",
            encoding="utf-8",
            errors="ignore"
        ) as f:
            code_text = f.read()

        encoded = self.tokenizer(
            code_text,
            padding="max_length",
            truncation=True,
            max_length=self.max_length,
            return_tensors="pt"
        )

        return {
            "image": image_tensor,
            "input_ids": encoded["input_ids"].squeeze(0),
            "attention_mask": encoded["attention_mask"].squeeze(0),
            "label": torch.tensor(self.labels[idx], dtype=torch.long),
            "sample_id": self.sample_ids[idx],
            "image_name": self.image_names[idx],
            "group_id": self.group_ids[idx]
        }

    def get_groups(self):
        return self.group_ids

    def get_labels(self):
        return self.labels


